      "sha256": "924d8b149a3d443a3d9ffa39110107402ef4cb56ee860019b1cf3e6bc309ec09",
      "generator": "Windows System.Speech, Microsoft Hazel Desktop"
    },
    {
      "key": "check_patient",
      "text": "Speak loudly to the person and gently shake their shoulders.",
      "speaker": "instructor",
      "language": "en",
      "file": "tts_en/check_patient.wav",
      "duration_s": 3.499,
      "sha256": "b1fda2d91865ef0f36c8aff4d086e8607e0ad5ef146c8f8b2ad33f70e2a70dbd",
      "generator": "Windows System.Speech, Microsoft Hazel Desktop"
    },
    {
      "key": "call_help",
      "text": "No response? Call one one two immediately, on speakerphone. Then open the airway and check breathing for no more than ten seconds.",
      "speaker": "instructor",
      "language": "en",
      "file": "tts_en/call_help.wav",
      "duration_s": 7.762,
      "sha256": "41312a8c243bdad8dcffbf329ec7c51dd2282086e073853f206df69becc5fa99",
      "generator": "Windows System.Speech, Microsoft Hazel Desktop"
    },
    {
      "key": "cpr",
      "text": "Begin chest compressions: thirty compressions and two rescue breaths.",
