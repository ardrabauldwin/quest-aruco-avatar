      "duration_s": 4.226,
      "sha256": "f28cf00efd62a4b654969218bcb28616070866cf5ed6fba93dc578d420a7a7b7"
    },
    {
      "key": "aed_pads",
      "language": "pl",
      "speaker": "aed",
      "text": "Naklej elektrody na odsłoniętą klatkę piersiową pacjenta.",
