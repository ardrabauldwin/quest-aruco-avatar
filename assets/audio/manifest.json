      "sha256": "dbb992ea3f15566e37471ee2cca9a8456caf7692fa3d6be99dd1f61d6398a599"
    },
    {
      "key": "recovery",
      "language": "pl",
      "speaker": "instructor",
      "text": "Ćwiczenie zakończone. Omówcie teraz swoje działania.",
