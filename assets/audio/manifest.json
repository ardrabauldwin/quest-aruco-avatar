      "duration_s": 5.526,
      "sha256": "943be2b8a8acde620aa26bbc3093ab6c38d101ea45c79322a5c2d8077363b783"
    },
    {
      "key": "aed_instruction",
      "language": "pl",
      "speaker": "instructor",
      "text": "Włącz defibrylator i wykonuj jego polecenia.",
