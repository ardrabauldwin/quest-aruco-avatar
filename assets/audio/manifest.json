    },
    {
      "key": "check_patient",
      "language": "de",
      "speaker": "instructor",
      "text": "Sprechen Sie die Person laut an und rütteln Sie sie vorsichtig an den Schultern.",
      "file": "tts_de/check_patient.wav",
      "duration_s": 4.69,
      "sha256": "1d416bba560b2d8f80989ab238cdc18a497a6a2810af2dd09d2e23db3cb41c08"
    },
    {
      "key": "call_help",
      "language": "de",
      "speaker": "instructor",
      "text": "Keine Reaktion? Rufen Sie sofort hundertzwölf an, mit Lautsprecher. Dann Atemwege öffnen und die Atmung höchstens zehn Sekunden prüfen.",
      "file": "tts_de/call_help.wav",
      "duration_s": 9.845,
      "sha256": "44ddf4616a2825becc3894e72f40ebb94bf66f2c6f6bab3a0d745a640ccb396f"
    },
    {
      "key": "check_patient",
      "language": "pl",
      "speaker": "instructor",
      "text": "Głośno zwróć się do osoby i delikatnie potrząśnij ją za ramiona.",
      "file": "tts_pl/check_patient.wav",
      "duration_s": 5.016,
      "sha256": "c3b2ed61e99e9232d45f6d63bf07630cc3b8c3677e8dd6d12cf1a7bdea02f431"
    },
    {
      "key": "call_help",
      "language": "pl",
      "speaker": "instructor",
      "text": "Brak reakcji? Natychmiast zadzwoń pod sto dwanaście, na głośniku. Potem udrożnij drogi oddechowe i oceniaj oddech najwyżej dziesięć sekund.",
      "file": "tts_pl/call_help.wav",
      "duration_s": 11.146,
      "sha256": "b8071c81b62824a48521c28f1bff65909656ff10f7c0aeaa65a8cdbc71ad0341"
    },
    {
      "key": "marek_take_over",
      "language": "de",
      "speaker": "marek",
      "text": "Ich drücke weiter – kleben Sie die Elektroden!",
