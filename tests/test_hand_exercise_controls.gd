extends "res://tests/suite.gd"

func run() -> Array[String]:
	failures.clear()
	var tree := Engine.get_main_loop() as SceneTree
	var origin := XROrigin3D.new()
	tree.root.add_child(origin)
	var interaction := NaretXRInteraction.new()
	tree.root.add_child(interaction)
	interaction.set_process(false)
	var menu := NaretHandMenu.new()
	tree.root.add_child(menu)
	menu.configure(origin, 0, interaction)
	menu.set_process(false)
	menu._rig.visible = true
	menu._controls.position = Vector3(0, 0.3, 0)
	var audio := NaretAudioManager.new()
	tree.root.add_child(audio)
	var started: Array = []
	audio.utterance_started.connect(func(_text: String, language: String, _source: String, _speaker: String): started.append(language))
	menu.voice_sample_requested.connect(func(): audio.speak("", "en", "anna_arrive", "bystander"))
	menu._language_menu.pressed.emit()
	var selected: Array = []
	menu.language_requested.connect(func(code: String): selected.append(code))
	var sample := menu._language_keys["en"] as Node3D
	var hit := interaction._poke_panel(sample.global_position + Vector3(0, 0, 0.003))
	check(hit.get("target") == sample, "fingertip must pick the visible voice button")
	interaction._click_hit(hit, true, "test")
	interaction._click_hit({}, false, "test")
	await tree.process_frame
	check(selected == ["en"] and not menu._language_choices.visible, "language selection emits once and folds the pop-up away")
	menu.set_language("en")
	check(menu._language_keys["en"].fill.a > 0.0, "selected English remains highlighted")
	menu._language_menu.pressed.emit()
	check(menu._language_choices.visible, "Languages key pops the choices up again")
	menu._language_menu.pressed.emit()
	check(not menu._language_choices.visible, "a second press on Languages closes the pop-up")
	check(not menu._lang_key.visible and not menu._mode_key.visible, "cuff drops the duplicate language and mode keys (Mode is a fold-out key now)")
	var scenario := NaretScenario.new()
	var actions: Array = []
	menu.action_requested.connect(func(action: String): actions.append(action))
	menu.update_session(scenario)
	hit = interaction._poke_panel(menu._large_start.global_position + Vector3(0, 0, 0.003))
	interaction._click_hit(hit, true, "test")
	check(actions == ["start"], "Start activates on contact without requiring withdrawal")
	interaction._send_pointer(hit, true, true)
	check(actions == ["start"], "Held contact does not repeat Start")
	interaction._click_hit({}, false, "test")
	check(actions == ["start"], "start button press and release sends start action")
	var saves: Array = []
	menu.alignment_save_requested.connect(func(): saves.append(true))
	hit = interaction._poke_panel(menu._large_align.global_position + Vector3(0, 0, 0.003))
	check(hit.get("target") == menu._large_align, "fingertip must pick the save-alignment key, not Start")
	interaction._click_hit(hit, true, "test")
	interaction._click_hit({}, false, "test")
	check(saves.size() == 1 and actions == ["start"], "save-alignment key replaces the controller A button")
	var repositions: Array = []
	menu.reposition_requested.connect(func(): repositions.append(true))
	hit = interaction._poke_panel(menu._reposition_key.global_position + Vector3(0,0,.003))
	check(hit.get("target")==menu._reposition_key, "Reposition has its own reachable hand-menu hit target")
	interaction._click_hit(hit,true,"test")
	interaction._click_hit({},false,"test")
	check(repositions.size()==1 and actions==["start"] and saves.size()==1, "Reposition emits once without Start or Save")
	menu.set_language("de")
	check(menu._reposition_key.label.text=="Neu platzieren", "German Reposition label")
	menu.set_language("pl")
	check(menu._reposition_key.label.text=="Ustaw ponownie", "Polish Reposition label")
	menu.set_language("en")
	var floor_requests: Array = []
	menu.floor_calibration_requested.connect(func(): floor_requests.append(true))
	hit = interaction._poke_panel(menu._floor_key.global_position + menu._floor_key.global_basis.z * 0.003)
	check(hit.get("target") == menu._floor_key, "fingertip must pick the floor-calibration key on the cuff")
	interaction._click_hit(hit, true, "test")
	interaction._click_hit({}, false, "test")
	check(floor_requests.size() == 1 and saves.size() == 1, "floor-calibration key starts the fingertip measurement only")
	menu.set_floor_calibrating(true)
	menu.set_chest_calibrating(true)
	check(menu._floor_key.fill.a > 0.0 and menu._chest_key.fill.a > 0.0, "calibration keys stay green while measuring")
	menu.set_language("de")
	check(menu._floor_key.fill.a > 0.0 and menu._chest_key.fill.a > 0.0, "a language switch keeps them green")
	menu.set_floor_calibrating(false)
	menu.set_chest_calibrating(false)
	check(menu._floor_key.fill.a == 0.0 and menu._chest_key.fill.a == 0.0, "calibration keys go dark once the measurement ends")
	menu.set_language("en")
	var mic_requests: Array = []
	menu.recording_requested.connect(func(active: bool): mic_requests.append(active))
	hit = interaction._poke_panel(menu._mic_key.global_position + menu._mic_key.global_basis.z * 0.003)
	check(hit.get("target") == menu._mic_key, "fingertip must pick the microphone key on the cuff")
	interaction._click_hit(hit, true, "test")
	interaction._click_hit({}, false, "test")
	check(mic_requests == [true] and menu._mic_key.fill.a > 0.0, "cuff microphone key switches listening on and turns green")
	# 20 Nov 2026: a notice is a notification plate in the screen's header, in place of the
	# brand while it shows; an empty notice brings the brand back.
	menu.show_notice("Boden kalibriert")
	check(menu._notice_plate.visible and menu.notice_text() == "Boden kalibriert" and menu._brand_parts.all(func(part): return not part.visible), "a notice shows on its plate in the header, over the brand")
	check(menu._controls.is_ancestor_of(menu._notice), "the notice is part of the screen on the hand")
	menu.show_notice("")
	check(not menu._notice_plate.visible and menu._brand_parts.all(func(part): return part.visible), "an empty notice takes the plate away and shows NaReT again")
	# Testing aids live in the Debug pop-up, which shares the Languages row behaviour.
	check(not menu._debug_choices.visible, "debug toggles start folded away")
	menu._language_menu.pressed.emit()
	check(menu._debug_menu.get_parent() == menu._cuff, "the single Debug key lives on the cuff")
	hit = interaction._poke_panel(menu._debug_menu.global_position + menu._debug_menu.global_basis.z * 0.003)
	check(hit.get("target") == menu._debug_menu, "fingertip must pick the Debug key on the cuff")
	interaction._click_hit(hit, true, "test")
	interaction._click_hit({}, false, "test")
	check(menu._debug_choices.visible and not menu._language_choices.visible, "Debug opens its toggles and folds the languages away")
	# 20 Nov 2026: the toggles are a page of the screen beside the hand, not a row past the cuff.
	check(menu._rig.is_ancestor_of(menu._debug_choices) and not menu._cuff.is_ancestor_of(menu._debug_choices) and not menu._controls.visible, "the Debug page takes the grid's place on the screen")
	check(menu._popup_root.global_transform.is_equal_approx(menu._controls.global_transform), "the Debug page opens where the grid is")
	var gizmo_toggles: Array = []
	menu.marker_gizmos_toggled.connect(func(shown: bool): gizmo_toggles.append(shown))
	hit = interaction._poke_panel(menu._gizmos_key.global_position + Vector3(0, 0, 0.003))
	check(hit.get("target") == menu._gizmos_key, "fingertip must pick the gizmo key in the Debug row")
	interaction._click_hit(hit, true, "test")
	interaction._click_hit({}, false, "test")
	check(gizmo_toggles == [true] and menu._gizmos_key.fill.a > 0.0 and menu._debug_choices.visible, "gizmo key switches on, turns green and keeps the Debug row open")
	var scans: Array = []
	menu.reference_scan_toggled.connect(func(shown: bool): scans.append(shown))
	hit = interaction._poke_panel(menu._scan_key.global_position + menu._scan_key.global_basis.z * 0.003)
	check(hit.get("target") == menu._scan_key, "fingertip must pick the reference-scan key in the Debug row")
	interaction._click_hit(hit, true, "test")
	interaction._click_hit({}, false, "test")
	interaction._click_hit(hit, true, "test")
	interaction._click_hit({}, false, "test")
	check(scans == [true, false], "reference-scan key toggles the scan on and off")
	var hand_toggles: Array = []
	menu.hand_meshes_toggled.connect(func(shown: bool): hand_toggles.append(shown))
	hit = interaction._poke_panel(menu._hands_key.global_position + menu._hands_key.global_basis.z * 0.003)
	check(hit.get("target") == menu._hands_key, "fingertip must pick the hand-mesh key in the Debug row")
	interaction._click_hit(hit, true, "test")
	interaction._click_hit({}, false, "test")
	check(hand_toggles == [true] and menu._hands_key.fill.a > 0.0, "hand-mesh key switches the meshes on and turns green")
	var occlusion_requests: Array = []
	menu.occlusion_requested.connect(func(mode: String):
		occlusion_requests.append(mode)
		menu.set_occlusion(mode))
	for i in 3:
		hit = interaction._poke_panel(menu._occlusion_key.global_position + menu._occlusion_key.global_basis.z * 0.003)
		interaction._click_hit(hit, true, "test")
		interaction._click_hit({}, false, "test")
	check(occlusion_requests == ["all", "off", "room"], "depth key cycles room → all → off → room, got %s" % [occlusion_requests])
	menu._debug_menu.pressed.emit()
	check(not menu._debug_choices.visible and menu._controls.visible, "a second press on Debug closes its toggles and brings the grid back")
	scenario.start()
	scenario.compressions = 17
	menu.update_session(scenario)
	check(menu._large_start.label.text == "Restart training", "active exercise always offers Restart instead of an inert Training active button")
	var before := actions.size()
	menu._large_start.pressed.emit()
	check(actions.size() == before and menu._large_start.label.text != "Restart training", "a first press during training only arms Restart (19 Nov 2026: accidental restarts)")
	menu.update_session(scenario)
	check(menu._large_start.label.text != "Restart training", "the confirm label stays while armed")
	# 20 Nov 2026 (user: "every option should remain clickable and editable"): nothing is
	# hidden while training, and a key still opens its pop-up and takes a choice.
	# Later that day (user: "use the palm for all dialogue; show my dialogue too"): while a
	# training runs the screen is the dialogue, and the cuff's page key turns it to the keys.
	check(menu._dialogue_root.visible and not menu._setup_keys["situation"].visible and not menu._language_menu.visible and menu._large_start.visible, "during training the screen shows the dialogue and Restart")
	check(menu._page_key.visible and menu._page_key.get_parent() == menu._cuff and menu._page_key.label.text == "Menu", "the cuff's page key offers the menu, got " + menu._page_key.label.text)
	menu.add_dialogue("Instructor", "You see a person who needs help. What do you do first?", false)
	menu.add_dialogue("You", "First I check the surroundings.", true)
	var lines := menu.dialogue()
	check(lines.size() == 2 and not lines[0].own and lines[1].own and lines[1].who == "You", "the dialogue lists the instructor's line and the trainee's own, marked as such")
	var plates: Array = menu._dialogue_root.get_children().filter(func(node): return node is MeshInstance3D and (node.mesh as BoxMesh).size.x > 0.05)
	check(plates.size() == 2 and (plates[0].mesh as BoxMesh).size.x > (plates[1].mesh as BoxMesh).size.x + 0.01 and plates[1].position.x > plates[0].position.x, "the trainee's plate is narrower and set in from the left")
	check(plates[0].material_override.albedo_color != plates[1].material_override.albedo_color, "and has another colour than the instructor's")
	check(plates[0].position.y > plates[1].position.y, "older lines stand above newer ones")
	menu.add_dialogue("You", "First I check the surroundings.", true)
	check(menu.dialogue().size() == 2, "the same line twice in a row is listed once")
	for i in 4: menu.add_dialogue("Instructor", "Line %d" % i, false)
	check(menu.dialogue().size() == NaretHandMenu.DIALOGUE_KEEP and menu.dialogue().back().text == "Line 3", "only the last lines are kept")
	menu.show_notice("Line 9")
	menu.add_dialogue("Instructor", "Line 9", false)
	check(menu.notice_text() == "", "a line in the dialogue is not shown in the notice as well")
	menu._page_key.pressed.emit()
	check(not menu._dialogue_root.visible and menu._page_key.label.text == "Dialogue", "the page key turns the screen to the settings")
	check(menu._setup_keys["situation"].visible and menu._setup_keys["breaths"].visible and menu._setup_keys["gender"].visible and menu._language_menu.visible and menu._large_align.visible and menu._reposition_key.visible, "there every key of the grid is available during training")
	var mid_training: Array = []
	menu.setup_requested.connect(func(step: String, value: String): mid_training.append(step + "=" + value))
	menu._setup_keys["situation"].pressed.emit()
	check(menu._setup_choices["situation"].visible, "Situation opens its pop-up during training")
	menu.update_session(scenario)
	check(menu._setup_choices["situation"].visible, "and the pop-up stays open while the training runs")
	menu._setup_option_keys["situation"]["A"].pressed.emit()
	check(mid_training == ["situation=A"] and not menu.popup_open() and menu._controls.visible, "a choice made during training is taken and the pop-up closes, got %s" % [mid_training])
	menu._large_start.pressed.emit()
	check(actions.back() == "restart", "the second press restarts")
	scenario.start()
	check(scenario.state == NaretScenario.State.INTRO and scenario.compressions == 0, "restart returns to introduction with cleared counts")
	var fallback_camera := Camera3D.new()
	origin.add_child(fallback_camera)
	menu._set_shown(true)
	menu._show_control_fallback(fallback_camera)
	check(not menu._rig.visible, "without a tracked hand or controller the menu hides instead of floating in space")
	scenario.free()
	audio.stop_speech()
	audio.free()
	menu.free()
	interaction.free()
	origin.free()
	return failures
