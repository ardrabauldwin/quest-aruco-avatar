extends "res://tests/suite.gd"

func run() -> Array[String]:
	failures.clear()
	var tree := Engine.get_main_loop() as SceneTree
	var origin := XROrigin3D.new()
	tree.root.add_child(origin)
	var interaction := NaretXRInteraction.new()
	tree.root.add_child(interaction)
	interaction.set_process(false)
	var menu := NaretHandMenu.new()
	tree.root.add_child(menu)
	menu.configure(origin, 0, interaction)
	menu.set_process(false)
	menu._rig.visible = true
	menu._controls.position = Vector3(0, 0.3, 0)
	var audio := NaretAudioManager.new()
	tree.root.add_child(audio)
	var started: Array = []
	audio.utterance_started.connect(func(_text: String, language: String, _source: String, _speaker: String): started.append(language))
	menu.voice_sample_requested.connect(func(): audio.speak("", "en", "anna_arrive", "bystander"))
	menu._language_menu.pressed.emit()
	var selected: Array = []
	menu.language_requested.connect(func(code: String): selected.append(code))
	var sample := menu._language_keys["en"] as Node3D
	var hit := interaction._poke_panel(sample.global_position + Vector3(0, 0, 0.003))
	check(hit.get("target") == sample, "fingertip must pick the visible voice button")
	interaction._click_hit(hit, true, "test")
	interaction._click_hit({}, false, "test")
	await tree.process_frame
	check(selected == ["en"] and not menu._language_choices.visible, "language selection emits once and folds the pop-up away")
	menu.set_language("en")
	check(menu._language_keys["en"].fill.a > 0.0, "selected English remains highlighted")
	menu._language_menu.pressed.emit()
	check(menu._language_choices.visible, "Languages key pops the choices up again")
	menu._language_menu.pressed.emit()
	check(not menu._language_choices.visible, "a second press on Languages closes the pop-up")
	check(not menu._lang_key.visible and menu._mode_key.visible, "cuff drops the duplicate language key but keeps mode")
	var scenario := NaretScenario.new()
	var actions: Array = []
	menu.action_requested.connect(func(action: String): actions.append(action))
	menu.update_session(scenario)
	hit = interaction._poke_panel(menu._large_start.global_position + Vector3(0, 0, 0.003))
	interaction._click_hit(hit, true, "test")
	check(actions == ["start"], "Start activates on contact without requiring withdrawal")
	interaction._send_pointer(hit, true, true)
	check(actions == ["start"], "Held contact does not repeat Start")
	interaction._click_hit({}, false, "test")
	check(actions == ["start"], "start button press and release sends start action")
	var saves: Array = []
	menu.alignment_save_requested.connect(func(): saves.append(true))
	hit = interaction._poke_panel(menu._large_align.global_position + Vector3(0, 0, 0.003))
	check(hit.get("target") == menu._large_align, "fingertip must pick the save-alignment key, not Start")
	interaction._click_hit(hit, true, "test")
	interaction._click_hit({}, false, "test")
	check(saves.size() == 1 and actions == ["start"], "save-alignment key replaces the controller A button")
	var floor_requests: Array = []
	menu.floor_calibration_requested.connect(func(): floor_requests.append(true))
	hit = interaction._poke_panel(menu._floor_key.global_position + menu._floor_key.global_basis.z * 0.003)
	check(hit.get("target") == menu._floor_key, "fingertip must pick the floor-calibration key on the cuff")
	interaction._click_hit(hit, true, "test")
	interaction._click_hit({}, false, "test")
	check(floor_requests.size() == 1 and saves.size() == 1, "floor-calibration key starts the fingertip measurement only")
	var mic_requests: Array = []
	menu.recording_requested.connect(func(active: bool): mic_requests.append(active))
	hit = interaction._poke_panel(menu._mic_key.global_position + menu._mic_key.global_basis.z * 0.003)
	check(hit.get("target") == menu._mic_key, "fingertip must pick the microphone key on the cuff")
	interaction._click_hit(hit, true, "test")
	interaction._click_hit({}, false, "test")
	check(mic_requests == [true] and menu._mic_key.fill.a > 0.0, "cuff microphone key switches listening on and turns green")
	var scans: Array = []
	menu.reference_scan_toggled.connect(func(shown: bool): scans.append(shown))
	hit = interaction._poke_panel(menu._scan_key.global_position + menu._scan_key.global_basis.z * 0.003)
	check(hit.get("target") == menu._scan_key, "fingertip must pick the reference-scan key on the cuff")
	interaction._click_hit(hit, true, "test")
	interaction._click_hit({}, false, "test")
	interaction._click_hit(hit, true, "test")
	interaction._click_hit({}, false, "test")
	check(scans == [true, false], "reference-scan key toggles the scan on and off")
	var hand_toggles: Array = []
	menu.hand_meshes_toggled.connect(func(shown: bool): hand_toggles.append(shown))
	hit = interaction._poke_panel(menu._hands_key.global_position + menu._hands_key.global_basis.z * 0.003)
	check(hit.get("target") == menu._hands_key, "fingertip must pick the hand-mesh key beside the floor key")
	interaction._click_hit(hit, true, "test")
	interaction._click_hit({}, false, "test")
	check(hand_toggles == [true] and menu._hands_key.fill.a > 0.0, "hand-mesh key switches the meshes on and turns green")
	var occlusion_requests: Array = []
	menu.occlusion_requested.connect(func(mode: String):
		occlusion_requests.append(mode)
		menu.set_occlusion(mode))
	for i in 3:
		hit = interaction._poke_panel(menu._occlusion_key.global_position + menu._occlusion_key.global_basis.z * 0.003)
		interaction._click_hit(hit, true, "test")
		interaction._click_hit({}, false, "test")
	check(occlusion_requests == ["all", "off", "room"], "depth key cycles room → all → off → room, got %s" % [occlusion_requests])
	check(is_equal_approx(menu._ring_key.position.y, NaretHandMenu.CUFF_ROW_Y[1]), "ring key sits in the second cuff row")
	var fallback_camera := Camera3D.new()
	origin.add_child(fallback_camera)
	menu._set_shown(true)
	menu._show_control_fallback(fallback_camera)
	check(not menu._rig.visible, "without a tracked hand or controller the menu hides instead of floating in space")
	scenario.free()
	audio.stop_speech()
	audio.free()
	menu.free()
	interaction.free()
	origin.free()
	return failures
